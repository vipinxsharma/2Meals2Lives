NEXT_PUBLIC_STRAPI_URL=https://cms.2hands2meals2lives1movement.org
NEXT_PUBLIC_SITE_URL=https://2hands2meals2lives1movement.org

# --- Resend (welcome email) ---
# Required by app/api/subscribe/route.ts. Both vars must be set together; the
# route returns 500 if either is missing.
# RESEND_API_KEY=re_...                                  (domain-restricted token)
# RESEND_FROM_EMAIL=hello@2hands2meals2lives1movement.org (must be verified in Resend)

# --- Strapi write access ---
# Required by app/api/subscribe/route.ts to POST /api/subscribers via Bearer.
# Generate in Strapi admin -> Settings -> API Tokens. Scope to subscriber.create
# (and any other writes you wire up later, e.g. journal-post.update for an
# in-site editor).
# STRAPI_TOKEN=
